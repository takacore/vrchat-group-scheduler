{
    "manifest_version": 3,
    "name": "VRChat Group Notify Scheduler",
    "version": "2.2.0.3",
    "description": "Schedule and automate group announcements on VRChat.",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "cookies",
        "notifications",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "https://vrchat.com/*",
        "https://api.x.com/*",
        "https://x.com/*",
        "https://upload.x.com/*",
        "https://abs.twimg.com/*"
    ],
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "VRChat Group Scheduler"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}